{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm install && npm run build -w @click-on-the-go/frontend",
  "outputDirectory": "dist/click-on-the-go/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "BACKEND_PUBLIC_URL": "https://click-on-the-gobackend-production.up.railway.app"
  }
}
