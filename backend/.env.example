# ============================================================
# ClickOnTheGo — Backend (.env local de desarrollo)
# Copia este archivo a `.env` (en la carpeta backend/) y llena
# los valores. NO lo subas a git. En Railway/Vercel se definen
# como variables de entorno (ver SETUP.md).
# ============================================================

# ---- PostgreSQL / Neon ----
# Opción A (recomendada): connection string completa de Neon
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Opción B: variables individuales
# DATABASE_USERNAME=postgres
# DATABASE_HOST=ep-xxxx.region.aws.neon.tech
# DATABASE_NAME=neondb
# DATABASE_PASSWORD=xxxxxxxx
# DATABASE_PORT=5432
# DATABASE_SSL=true

# ---- Google Gemini (AI Vision) ----
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Vercel Blob (almacenamiento staging de imágenes) ----
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXX

# ---- Wix Catalog V3 (headless) ----
# Si no defines WIX_API_KEY ni WIX_SITE_ID, el backend usa el
# ADAPTADOR MOCK (PoC) para no requerir credenciales reales.
WIX_API_KEY=
WIX_SITE_ID=

# ---- Autenticación de dispositivos ----
# Password para generar token de un solo uso (POST /api/auth/one-time-token)
ADMIN_TOKEN=change-me-admin

# ---- SKU ----
SKU_PREFIX=SKU-

# ---- Servidor ----
PORT=4000

# ---- Frontend (para armar el link de invitación de dispositivo) ----
APP_BASE_URL=http://localhost:4200

# ---- URL pública de este backend (para que el frontend apunte aquí) ----
# En local: http://localhost:4000
# En Railway: https://<tu-app>.up.railway.app
BACKEND_PUBLIC_URL=http://localhost:4000
